# EditorConfig — one source of truth for whitespace, so that shfmt, editors and
# .gitattributes cannot disagree.
#
# Why this file exists rather than a flag list scattered across tools: shfmt
# reads .editorconfig for its defaults, so declaring the style here means the
# pre-commit hook, a contributor's editor and CI all format identically without
# a per-invocation argument list to drift out of sync.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# Shell: shfmt's domain.  Tabs, and case branches KEEP their indentation —
# `indent_size = 4` with `indent_style = tab` is what makes shfmt leave the
# project's existing `case` layout alone instead of flattening it to column 0
# (which `--indent 0` does, and which is a readability regression this project
# deliberately does not want).
[*.sh]
indent_style = tab
indent_size = 4
switch_case_indent = true
space_redirects = false

# The device-side scripts have no extension.
[{scripts/*,local-packages/**/usr/sbin/*,local-packages/**/uci-defaults/*,local-packages/**/hotplug.d/**/*}]
indent_style = tab
indent_size = 4
switch_case_indent = true
space_redirects = false

# YAML / JSON / Markdown: spaces, as every tool in this ecosystem expects.
[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
indent_size = 8

[*.{c,h}]
indent_style = tab
indent_size = 8
