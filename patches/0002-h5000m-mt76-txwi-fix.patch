diff --git a/package/kernel/mt76/patches/100-mt7996-always-fill-txwi.patch b/package/kernel/mt76/patches/100-mt7996-always-fill-txwi.patch
new file mode 100644
index 0000000..6bfb2eb
--- /dev/null
+++ b/package/kernel/mt76/patches/100-mt7996-always-fill-txwi.patch
@@ -0,0 +1,64 @@
+From: Ziyang Huang <hzyitc@outlook.com>
+Subject: [PATCH] mt7996: always fill TXWI and apply TXD for 802.3 frames
+
+On MT7992/MT7996 the firmware mis-parses hardware-encapsulated 802.3
+frames when the host leaves the TXWI blank.  On the Hiveton H5000M
+(MT7987A + MT7992/MT7991A) this shows up as broken/degraded Wi-Fi: IPv4
+NAT traffic towards Wi-Fi clients collapses to 30-40 Mbit/s in the
+download direction while upload, IPv6, IPv6 NAT and wired NAT all run at
+line rate, and toggling flow offload (none/software/hardware) makes no
+difference.  The board is named in the upstream issue thread and the
+reporter confirmed this change fixes it.
+
+Fill the TXWI and set MT_CT_INFO_APPLY_TXD unconditionally instead of
+only for non-802.3 frames and frames carrying a status pid, so the
+firmware always gets a descriptor it can process.
+
+Link: https://github.com/openwrt/mt76/issues/1043
+Link: https://github.com/openwrt/mt76/issues/1043#issuecomment-4861848897
+---
+diff --git a/mt7996/mac.c b/mt7996/mac.c
+index 8388014..0696873 100644
+--- a/mt7996/mac.c
++++ b/mt7996/mac.c
+@@ -1057,7 +1057,6 @@
+ 	bool is_8023 = info->flags & IEEE80211_TX_CTL_HW_80211_ENCAP;
+ 	__le32 *ptr = (__le32 *)txwi_ptr;
+ 	u8 *txwi = (u8 *)txwi_ptr;
+-	bool host_txd;
+ 	u8 link_id;
+ 
+ 	if (unlikely(tx_info->skb->len <= ETH_HLEN))
+@@ -1142,18 +1141,11 @@
+ 
+ 	wcid = mt7996_get_tx_wcid(wcid);
+ 
+-	/* mt76_tx_status_skb_add() clears info->control.flags */
+-	host_txd = !is_8023 ||
+-		   (info->control.flags & (IEEE80211_TX_CTRL_STREAM_CLASSIFIED |
+-					   IEEE80211_TX_CTRL_EXPLICIT_UP));
+-
+ 	pid = mt76_tx_status_skb_add(mdev, wcid, tx_info->skb);
+ 	memset(txwi_ptr, 0, MT_TXD_SIZE);
+-	/* Transmit non qos data by 802.11 header and need to fill txd by host*/
+-	host_txd |= pid >= MT_PACKET_ID_FIRST;
+-	if (host_txd)
+-		mt7996_mac_write_txwi(dev, txwi_ptr, tx_info->skb, wcid, key,
+-				      pid, qid, 0, link_id);
++	/* Always fill txwi for firmware to avoid incorrect header processing */
++	mt7996_mac_write_txwi(dev, txwi_ptr, tx_info->skb, wcid, key,
++			      pid, qid, 0, link_id);
+ 
+ 	/* MT7996 and MT7992 require driver to provide the MAC TXP for AddBA
+ 	 * req
+@@ -1203,8 +1195,8 @@
+ 
+ 		txp->fw.flags = cpu_to_le16(MT_CT_INFO_FROM_HOST);
+ 
+-		if (host_txd)
+-			txp->fw.flags |= cpu_to_le16(MT_CT_INFO_APPLY_TXD);
++		/* Always apply TXD to ensure correct firmware processing */
++		txp->fw.flags |= cpu_to_le16(MT_CT_INFO_APPLY_TXD);
+ 
+ 		if (!key)
+ 			txp->fw.flags |= cpu_to_le16(MT_CT_INFO_NONE_CIPHER_FRAME);
