diff --git a/root/usr/share/firewall4/templates/ruleset.uc b/root/usr/share/firewall4/templates/ruleset.uc
index f5be6be..fada0ea 100644
--- a/root/usr/share/firewall4/templates/ruleset.uc
+++ b/root/usr/share/firewall4/templates/ruleset.uc
@@ -296,6 +296,10 @@
 
 	chain dstnat {
 		type nat hook prerouting priority dstnat; policy accept;
+{% if (fw4.default_option("fullcone")): %}
+		meta nfproto ipv4 fullcone comment "!fw4: Fullcone NAT inbound restore (IPv4)"
+		meta nfproto ipv6 fullcone comment "!fw4: Fullcone NAT inbound restore (IPv6)"
+{% endif %}
 {% fw4.includes('chain-prepend', 'dstnat') %}
 {% for (let redirect in fw4.redirects("dstnat")): %}
 		{%+ include("redirect.uc", { fw4, zone: null, redirect }) %}
diff --git a/root/usr/share/firewall4/templates/zone-masq.uc b/root/usr/share/firewall4/templates/zone-masq.uc
index c3e66d8..6ca6cee 100644
--- a/root/usr/share/firewall4/templates/zone-masq.uc
+++ b/root/usr/share/firewall4/templates/zone-masq.uc
@@ -10,4 +10,8 @@
 	{{ fw4.ipproto(family) }} daddr != {{ fw4.set(map(daddrs[1], fw4.cidr)) }} {%+ endif -%}
 {%+ for (let a in (daddrs ? daddrs[2] : [])): -%}
 	{{ fw4.ipproto(family) }} daddr & {{ a.mask }} {{ a.invert ? '!=' : '==' }} {{ a.addr }} {%+ endfor -%}
+{% if (fw4.default_option("fullcone")): %}
+fullcone comment "!fw4: Fullcone NAT {{ fw4.nfproto(family, true) }} {{ zone.name }} traffic"
+{% else %}
 masquerade comment "!fw4: Masquerade {{ fw4.nfproto(family, true) }} {{ zone.name }} traffic"
+{% endif %}
diff --git a/root/usr/share/ucode/fw4.uc b/root/usr/share/ucode/fw4.uc
index c36f044..4a7f977 100644
--- a/root/usr/share/ucode/fw4.uc
+++ b/root/usr/share/ucode/fw4.uc
@@ -2046,6 +2046,13 @@
 			flow_offloading: [ "bool", "0" ],
 			flow_offloading_hw: [ "bool", "0" ],
 
+			/* Without this entry the option is not unknown-but-harmless:
+			 * parse_options() only copies keys it is told about and warns
+			 * "specifies unknown option 'fullcone'" for the rest, so
+			 * default_option("fullcone") would return null and the two
+			 * templates above would emit nothing at all -- silently. */
+			fullcone: [ "bool", "0" ],
+
 			auto_includes: [ "bool", "1" ]
 		});
 
