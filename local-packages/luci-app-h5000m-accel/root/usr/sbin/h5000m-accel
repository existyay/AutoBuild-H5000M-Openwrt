#!/bin/sh
# Apply the H5000M acceleration settings.
#
# On mainline this device has no HNAT and no TurboACC: hardware acceleration is
# the PPE driven through netfilter's flowtable, which fw4 exposes as
# flow_offloading_hw.  This writes those two switches, optionally turns on BBR,
# carries the fullcone switch through to firewall4 (which is where a full-cone
# rule is actually emitted — the acceleration page only records the intent),
# and loads the eBPF proxy's TC modules so Nikki-RS's fast path can attach.  It
# deliberately does not pretend to offer anything else.

CONF=h5000m_accel

log() { logger -t h5000m-accel "$@" 2>/dev/null || true; }

# eBPF proxy fast path (Nikki-RS / clash-rs).
#
# The kernel half of the datapath is TC eBPF: a clsact qdisc carrying cls_bpf /
# act_bpf programs.  Those modules are demand-loaded when the core attaches, but
# loading them here means the status page can say "ready" immediately and the
# first attach does not have to race module loading.
#
# The switch is a tristate and defaults to "keep": Nikki-RS has its own eBPF
# page, and a page that always wrote nikki-rs.ebpf.enabled would silently
# override it on every save.  Only an explicit on/off touches the other package.
apply_ebpf_proxy() {
	local want="$1" cur

	modprobe sch_ingress 2>/dev/null
	modprobe cls_bpf 2>/dev/null
	modprobe act_bpf 2>/dev/null
	# The eBPF manager creates dae0 <-> dae0peer as a netkit/veth pair before
	# it loads any program; preloading veth removes the EOPNOTSUPP first-run
	# failure when the module is present but not yet loaded.
	modprobe veth 2>/dev/null

	case "$want" in
		on | 1) want=1 ;;
		off | 0) want=0 ;;
		*) return 0 ;; # keep / empty / unknown: this page does not manage it
	esac

	# Nothing to drive unless Nikki-RS is installed.  Touching its UCI anyway
	# would leave a half-created /etc/config/nikki-rs behind for a service that
	# is not there.
	if [ ! -f /etc/config/nikki-rs ]; then
		log "ebpf_proxy=${want} but Nikki-RS is not installed; skipping"
		return 0
	fi

	# The named section is created by Nikki-RS's own migrate.sh.  A hand-edited
	# config may lack it, and `uci set nikki-rs.ebpf.enabled` on a missing
	# section is an error rather than a create.
	if ! uci -q get nikki-rs.ebpf >/dev/null 2>&1; then
		uci -q set nikki-rs.ebpf=ebpf
		uci -q set nikki-rs.ebpf.enabled='0'
	fi

	cur="$(uci -q get nikki-rs.ebpf.enabled || echo 0)"
	[ "$cur" = "$want" ] && return 0

	uci -q set "nikki-rs.ebpf.enabled=${want}"
	uci -q commit nikki-rs
	if [ -x /etc/init.d/nikki-rs ]; then
		/etc/init.d/nikki-rs restart >/dev/null 2>&1
	fi
	log "nikki-rs eBPF enabled=${want}"
	return 0
}

# --- the router's own IPv6 addresses and the eBPF bypass list ----------------
#
# The eBPF hook is what decides "proxy or deliver locally": everything not in
# Nikki-RS's `bypass-dst-ips` is a candidate for the datapath.  The upstream
# default list covers the router's own IPv4 (192.168.0.0/16) and, on the IPv6
# side, only loopback (::1/128), link-local (fe80::/10) and multicast
# (ff00::/8) — so the ULA this firmware always generates and any delegated
# global address fall through to the proxy.
#
# The consequence is asymmetric and hard to read from the pages: a LAN client's
# DNS query to the router's IPv4 address is bypassed and answered by dnsmasq,
# while the same query to the router's IPv6 address is captured — IPv6 name
# resolution breaks while IPv4 keeps working, and nothing on the eBPF page
# mentions IPv6.  Reported on a real device as "开启 eBPF 后 IPv6 解析不对".
#
# fc00::/7 is the whole ULA range: it is never a public destination, so bypassing
# it cannot swallow anything that should be proxied — the same argument that puts
# 192.168.0.0/16 in the list upstream.  The router's own addresses are added as
# the on-link prefix they sit in rather than as a hard-coded range, because the
# delegated prefix changes with the ISP session and differs per device.
EBPF_BYPASS_ALWAYS='fc00::/7'

# The interfaces the hook filters: exactly the ones Nikki-RS attaches to, so an
# address that is not on one of them cannot arrive through this datapath.
ebpf_lan_devices() {
	uci -q get nikki-rs.ebpf.lan_interface 2>/dev/null | grep -v '^$' || echo br-lan
}

# Drop the leading zeros inside each group, so an address read from the kernel is
# spelled the way a user would write it — which is also what makes "this entry is
# already in the list" compare equal.  Two POSIX BRE substitutions, not one with
# `\|`: that alternation is a GNU extension and the device's sed is busybox's.
strip_v6_zeros() {
	printf '%s' "$1" | sed 's/^0*\([0-9a-f]\)/\1/; s/:0*\([0-9a-f]\)/:\1/g'
}

# 32 hex digits -> xxxx:xxxx:xxxx:xxxx:xxxx:xxxx:xxxx:xxxx
hex_ipv6() {
	local groups
	groups="$(printf '%s' "$1" | sed 's/\(....\)/\1:/g; s/:$//')"
	strip_v6_zeros "$groups"
}

# The on-link prefix an address belongs to, as `prefix/length`.  Four bits per
# hex digit, so keeping the first length/4 digits and zeroing the rest IS the
# mask.  Lengths that are not a multiple of 4 are rounded DOWN, i.e. the emitted
# prefix is wider than the interface's — a wider bypass can only let more of our
# own LAN through, while a narrower one would leave part of the router's traffic
# captured, which is the failure this fixes.
mask_ipv6() {
	local addr="$1" prefix="$2" keep masked
	keep=$((prefix / 4))
	masked="$(awk -v a="$addr" -v k="$keep" 'BEGIN {
		s = substr(a, 1, k);
		while (length(s) < 32) s = s "0";
		print s;
	}')"
	printf '%s/%s\n' "$(hex_ipv6 "$masked")" "$((keep * 4))"
}

# Everything that has to be in `bypass-dst-ips` once eBPF is on, one per line.
ebpf_bypass_want() {
	local devs addr prefix

	printf '%s\n' "$EBPF_BYPASS_ALWAYS"

	devs=" $(ebpf_lan_devices | tr '\n' ' ') "

	# /proc/net/if_inet6 instead of `ip -6 addr`: no dependency on which `ip`
	# implementation is installed, and no output format to parse.  Field order is
	# address, ifindex, prefixlen, scope, flags, devname.
	[ -r /proc/net/if_inet6 ] || return 0
	awk -v devs="$devs" '
		# 0x00 is global scope — a ULA counts.  Link-local (0x20) is already
		# covered by the upstream fe80::/10 entry, and host scope (0x10) is ::1.
		$4 == "00" && index(devs, " " $6 " ") > 0 { print $1, $3 }
	' /proc/net/if_inet6 |
		while read -r addr prefix; do
			# `0x$prefix`, not bash's `16#$prefix`: this runs under the image's
			# ash, where the 16# form is not an arithmetic constant at all (the
			# same trap that made normalize_source_mtimes print 1722 arithmetic
			# errors before it was fixed).
			mask_ipv6 "$addr" "$((0x$prefix))"
		done
	return 0
}

# The subset of ebpf_bypass_want() that the config does not have yet.
ebpf_bypass_missing() {
	local cur cidr
	[ -f /etc/config/nikki-rs ] || return 0
	# Only when the datapath is actually on: with eBPF disabled the list decides
	# nothing, and writing to another package's config for no active reason is
	# the kind of surprise this page exists to avoid.
	[ "$(uci -q get nikki-rs.ebpf.enabled 2>/dev/null || echo 0)" = '1' ] || return 0

	# uci prints a list on ONE line with the values separated by a space — cli.c's
	# uci_show_value(), UCI_TYPE_LIST — not one value per line.  Comparing whole
	# lines therefore never matched, and each run appended a second copy of every
	# entry.  That was found by running this against the target's own uci under
	# qemu; a mock that printed one value per line had said it was fine.
	# Normalising to a space-padded string and matching the token does not depend
	# on which separator the installed uci uses.
	cur=" $(uci -q get nikki-rs.ebpf.bypass_dst_ips 2>/dev/null | tr '\n' ' ') "
	for cidr in $(ebpf_bypass_want); do
		case "$cur" in
			*" $cidr "*) ;;
			*) printf '%s\n' "$cidr" ;;
		esac
	done
	return 0
}

# Append-only repair.  Existing entries are never removed or rewritten: the user
# may have added ranges deliberately, and this page does not own that list.
apply_ebpf_bypass_ips() {
	local cidr added=0

	for cidr in $(ebpf_bypass_missing); do
		uci -q add_list "nikki-rs.ebpf.bypass_dst_ips=${cidr}" || continue
		log "ebpf bypass: +${cidr}"
		added=$((added + 1))
	done

	[ "$added" -gt 0 ] || return 0
	uci -q commit nikki-rs

	# Restart only if the core is already up.  During boot this runs from
	# /etc/uci-defaults (via /etc/init.d/boot) before Nikki-RS starts, so the
	# corrected list is read on the way up and a restart would be a second start.
	if [ -x /etc/init.d/nikki-rs ] && /etc/init.d/nikki-rs running 2>/dev/null; then
		/etc/init.d/nikki-rs restart >/dev/null 2>&1
	fi
	log "ebpf bypass: added ${added} entry/entries"
	return 0
}

apply_settings() {
	local offload hw bbr

	# The profile decides the three switches unless it is 'custom'.  A preset is
	# what makes this page usable — getting offload right means knowing that
	# hardware offload without software offload does nothing, and that BBR needs
	# its module — without hiding the individual switches for anyone who wants
	# them.
	profile="$(uci -q get ${CONF}.settings.profile || echo performance)"
	fullcone="$(uci -q get ${CONF}.settings.fullcone || echo 0)"
	case "$profile" in
		performance)
			offload=1
			hw=1
			bbr=1
			;;
		compat)
			offload=1
			hw=0
			bbr=0
			;;
		*) # custom: read the switches, defaulting to the safe value
			offload="$(uci -q get ${CONF}.settings.flow_offload || echo 1)"
			hw="$(uci -q get ${CONF}.settings.flow_offload_hw || echo 0)"
			bbr="$(uci -q get ${CONF}.settings.bbr || echo 0)"
			;;
	esac

	# Keep the stored switches in step with the preset, so the page shows what is
	# actually in force instead of a stale custom value.
	if [ "$profile" != 'custom' ]; then
		uci -q batch <<-EOT
			set ${CONF}.settings.flow_offload='${offload}'
			set ${CONF}.settings.flow_offload_hw='${hw}'
			set ${CONF}.settings.bbr='${bbr}'
			commit ${CONF}
		EOT
	fi

	# `uci batch` strips the quoting correctly; `uci set "x='1'"` would store the
	# literal '1' and config_get_bool would not recognise it.
	uci -q get firewall.@defaults[0] >/dev/null 2>&1 || return 1

	uci -q batch <<-EOT
		set firewall.@defaults[0].flow_offloading='${offload}'
		set firewall.@defaults[0].flow_offloading_hw='${hw}'
		set firewall.@defaults[0].fullcone='${fullcone}'
		commit firewall
	EOT

	if [ "${bbr}" = '1' ]; then
		# The module has to be loaded before bbr appears in the available list;
		# without kmod-tcp-bbr installed there is nothing to load and the
		# sysctl below silently does nothing, which is how the page ended up
		# reporting "cubic" on a device where BBR had been switched on.
		modprobe tcp_bbr 2>/dev/null
		if grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null; then
			sysctl -qw net.ipv4.tcp_congestion_control=bbr 2>/dev/null ||
				log "could not switch to bbr"
		else
			log "bbr is not available (kmod-tcp-bbr missing?); staying on $(cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null)"
		fi
	else
		sysctl -qw net.ipv4.tcp_congestion_control=cubic 2>/dev/null
	fi

	# The eBPF proxy's kernel side.  Independent of the profile: it is a
	# different datapath, owned by Nikki-RS, and 'keep' (the default) leaves it
	# exactly as Nikki-RS left it.
	ebpf_proxy="$(uci -q get ${CONF}.settings.ebpf_proxy || echo keep)"
	apply_ebpf_proxy "$ebpf_proxy"

	log "applied: profile=${profile} flow_offloading=${offload} flow_offloading_hw=${hw} bbr=${bbr} fullcone=${fullcone} ebpf_proxy=${ebpf_proxy}"
	return 0
}

reload_firewall() {
	# Only if the firewall is actually up; on a fresh boot it may not be yet.
	[ -x /etc/init.d/firewall ] && /etc/init.d/firewall reload >/dev/null 2>&1
	return 0
}

case "${1:-apply}" in
	apply)
		# Before apply_settings, and not inside it: that function returns 1 as
		# soon as `firewall.@defaults[0]` is absent, so a repair living after
		# that point would silently not happen on a system whose firewall config
		# is not there yet.  This repair touches Nikki-RS's config only, and is a
		# no-op unless eBPF is actually enabled there.
		apply_ebpf_bypass_ips
		apply_settings && reload_firewall
		;;
	check-bypass)
		# Read-only, for the status panel: the entries the datapath needs and
		# does not have.  Empty output means nothing is missing.
		ebpf_bypass_missing
		;;
	*)
		echo "usage: $0 [apply|check-bypass]" >&2
		exit 1
		;;
esac
