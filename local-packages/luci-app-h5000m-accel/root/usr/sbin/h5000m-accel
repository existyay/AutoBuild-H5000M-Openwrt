#!/bin/sh
# Apply the H5000M acceleration settings.
#
# On mainline this device has no HNAT and no TurboACC: hardware acceleration is
# the PPE driven through netfilter's flowtable, which fw4 exposes as
# flow_offloading_hw.  This writes those two switches, optionally turns on BBR,
# carries the fullcone switch through to firewall4 (which is where a full-cone
# rule is actually emitted — the acceleration page only records the intent),
# and loads the eBPF proxy's TC modules so Nikki-RS's fast path can attach.  It
# deliberately does not pretend to offer anything else.

CONF=h5000m_accel

log() { logger -t h5000m-accel "$@" 2>/dev/null || true; }

# eBPF proxy fast path (Nikki-RS / clash-rs).
#
# The kernel half of the datapath is TC eBPF: a clsact qdisc carrying cls_bpf /
# act_bpf programs.  Those modules are demand-loaded when the core attaches, but
# loading them here means the status page can say "ready" immediately and the
# first attach does not have to race module loading.
#
# The switch is a tristate and defaults to "keep": Nikki-RS has its own eBPF
# page, and a page that always wrote nikki-rs.ebpf.enabled would silently
# override it on every save.  Only an explicit on/off touches the other package.
apply_ebpf_proxy() {
	local want="$1" cur

	modprobe sch_ingress 2>/dev/null
	modprobe cls_bpf 2>/dev/null
	modprobe act_bpf 2>/dev/null
	# The eBPF manager creates dae0 <-> dae0peer as a netkit/veth pair before
	# it loads any program; preloading veth removes the EOPNOTSUPP first-run
	# failure when the module is present but not yet loaded.
	modprobe veth 2>/dev/null

	case "$want" in
		on | 1) want=1 ;;
		off | 0) want=0 ;;
		*) return 0 ;; # keep / empty / unknown: this page does not manage it
	esac

	# Nothing to drive unless Nikki-RS is installed.  Touching its UCI anyway
	# would leave a half-created /etc/config/nikki-rs behind for a service that
	# is not there.
	if [ ! -f /etc/config/nikki-rs ]; then
		log "ebpf_proxy=${want} but Nikki-RS is not installed; skipping"
		return 0
	fi

	# The named section is created by Nikki-RS's own migrate.sh.  A hand-edited
	# config may lack it, and `uci set nikki-rs.ebpf.enabled` on a missing
	# section is an error rather than a create.
	if ! uci -q get nikki-rs.ebpf >/dev/null 2>&1; then
		uci -q set nikki-rs.ebpf=ebpf
		uci -q set nikki-rs.ebpf.enabled='0'
	fi

	cur="$(uci -q get nikki-rs.ebpf.enabled || echo 0)"
	[ "$cur" = "$want" ] && return 0

	uci -q set "nikki-rs.ebpf.enabled=${want}"
	uci -q commit nikki-rs
	if [ -x /etc/init.d/nikki-rs ]; then
		/etc/init.d/nikki-rs restart >/dev/null 2>&1
	fi
	log "nikki-rs eBPF enabled=${want}"
	return 0
}

apply_settings() {
	local offload hw bbr

	# The profile decides the three switches unless it is 'custom'.  A preset is
	# what makes this page usable — getting offload right means knowing that
	# hardware offload without software offload does nothing, and that BBR needs
	# its module — without hiding the individual switches for anyone who wants
	# them.
	profile="$(uci -q get ${CONF}.settings.profile || echo performance)"
	fullcone="$(uci -q get ${CONF}.settings.fullcone || echo 0)"
	case "$profile" in
		performance)
			offload=1
			hw=1
			bbr=1
			;;
		compat)
			offload=1
			hw=0
			bbr=0
			;;
		*) # custom: read the switches, defaulting to the safe value
			offload="$(uci -q get ${CONF}.settings.flow_offload || echo 1)"
			hw="$(uci -q get ${CONF}.settings.flow_offload_hw || echo 0)"
			bbr="$(uci -q get ${CONF}.settings.bbr || echo 0)"
			;;
	esac

	# Keep the stored switches in step with the preset, so the page shows what is
	# actually in force instead of a stale custom value.
	if [ "$profile" != 'custom' ]; then
		uci -q batch <<-EOT
			set ${CONF}.settings.flow_offload='${offload}'
			set ${CONF}.settings.flow_offload_hw='${hw}'
			set ${CONF}.settings.bbr='${bbr}'
			commit ${CONF}
		EOT
	fi

	# `uci batch` strips the quoting correctly; `uci set "x='1'"` would store the
	# literal '1' and config_get_bool would not recognise it.
	uci -q get firewall.@defaults[0] >/dev/null 2>&1 || return 1

	uci -q batch <<-EOT
		set firewall.@defaults[0].flow_offloading='${offload}'
		set firewall.@defaults[0].flow_offloading_hw='${hw}'
		set firewall.@defaults[0].fullcone='${fullcone}'
		commit firewall
	EOT

	if [ "${bbr}" = '1' ]; then
		# The module has to be loaded before bbr appears in the available list;
		# without kmod-tcp-bbr installed there is nothing to load and the
		# sysctl below silently does nothing, which is how the page ended up
		# reporting "cubic" on a device where BBR had been switched on.
		modprobe tcp_bbr 2>/dev/null
		if grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null; then
			sysctl -qw net.ipv4.tcp_congestion_control=bbr 2>/dev/null ||
				log "could not switch to bbr"
		else
			log "bbr is not available (kmod-tcp-bbr missing?); staying on $(cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null)"
		fi
	else
		sysctl -qw net.ipv4.tcp_congestion_control=cubic 2>/dev/null
	fi

	# The eBPF proxy's kernel side.  Independent of the profile: it is a
	# different datapath, owned by Nikki-RS, and 'keep' (the default) leaves it
	# exactly as Nikki-RS left it.
	ebpf_proxy="$(uci -q get ${CONF}.settings.ebpf_proxy || echo keep)"
	apply_ebpf_proxy "$ebpf_proxy"

	log "applied: profile=${profile} flow_offloading=${offload} flow_offloading_hw=${hw} bbr=${bbr} fullcone=${fullcone} ebpf_proxy=${ebpf_proxy}"
	return 0
}

reload_firewall() {
	# Only if the firewall is actually up; on a fresh boot it may not be yet.
	[ -x /etc/init.d/firewall ] && /etc/init.d/firewall reload >/dev/null 2>&1
	return 0
}

case "${1:-apply}" in
	apply)
		apply_settings && reload_firewall
		;;
	*)
		echo "usage: $0 apply" >&2
		exit 1
		;;
esac
