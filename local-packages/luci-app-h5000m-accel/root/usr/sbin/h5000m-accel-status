#!/bin/sh
# Report what the kernel is actually doing, not what the config asks for.
# The LuCI page shows these values, so a setting that failed to take effect is
# visible instead of merely assumed.

conf_get() { uci -q get "h5000m_accel.settings.$1" 2>/dev/null || echo ''; }
fw_get()   { uci -q get "firewall.@defaults[0].$1" 2>/dev/null || echo ''; }

echo "profile=$(conf_get profile)"
echo "flow_offload=$(conf_get flow_offload)"
echo "flow_offload_hw=$(conf_get flow_offload_hw)"
echo "bbr=$(conf_get bbr)"

# Effective firewall state — this is what decides whether offload happens.
echo "fw_flow_offloading=$(fw_get flow_offloading)"
echo "fw_flow_offloading_hw=$(fw_get flow_offloading_hw)"
# The fullcone switch is written into the same section; reporting only the
# module (below) let the page claim "firewall is generating fullcone rules"
# while the switch itself was off and masquerade was still in force.
echo "fw_fullcone=$(fw_get fullcone)"

# Effective congestion control.
cc="$(cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null || echo unknown)"
echo "tcp_congestion_control=${cc}"
case "${cc}" in
	bbr) echo "bbr_active=1" ;;
	*)   echo "bbr_active=0" ;;
esac
echo "bbr_available=$(grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null && echo 1 || echo 0)"

# --- PPE, the hardware behind hardware offload -------------------------------
#
# On this target the driver is NOT a module: CONFIG_NET_MEDIATEK_SOC=y, so it
# never appears in /proc/modules or /sys/module.  A built-in platform driver
# still registers under /sys/bus/platform/drivers/, and the name there is
# "mtk_soc_eth" (mtk_eth_soc.c: .name = "mtk_soc_eth") — which does NOT contain
# the substring "mtk_eth", so matching on that found nothing and the page
# reported "cannot determine" on a device where the driver was present all
# along.
#
# Several signals are checked and the one that matched is reported, so the page
# can say why it believes what it believes instead of just asserting a state.
ppe_state='unknown'
ppe_signal=''

for sig in mtk_ppe mtk_soc_eth mtk_wed; do
	if [ -e "/sys/module/${sig}" ] || [ -d "/sys/bus/platform/drivers/${sig}" ]; then
		ppe_state='present'
		ppe_signal="$sig"
		break
	fi
done

if [ "$ppe_state" = 'unknown' ] && grep -qE '^mtk_ppe|^mtk_soc_eth' /proc/modules 2>/dev/null; then
	ppe_state='present'
	ppe_signal='module list'
fi

# Last resort: a netdev whose driver is the MediaTek ethernet one.
if [ "$ppe_state" = 'unknown' ]; then
	for n in /sys/class/net/*/device/driver; do
		[ -e "$n" ] || continue
		if readlink "$n" 2>/dev/null | grep -qE 'mtk_soc_eth|mtk_ppe'; then
			ppe_state='present'
			ppe_signal="netdev $(basename "$(dirname "$(dirname "$n")")")"
			break
		fi
	done
fi

# /sys/bus/platform/devices is where a built-in driver's bound devices show up;
# used only to distinguish "driver present" from "driver present and bound".
if [ "$ppe_state" = 'present' ] && ls /sys/bus/platform/devices/ 2>/dev/null | grep -qiE 'mtk_ppe|mtk_soc_eth'; then
	ppe_signal="${ppe_signal} (bound)"
fi

echo "ppe_state=${ppe_state}"
echo "ppe_signal=${ppe_signal:-none}"

# Offloaded connections.  NF_FLOW_TABLE_PROCFS is not set in this kernel, so
# there is no /proc/net/stat/nf_flowtable to read; conntrack marks offloaded
# entries with OFFLOAD instead.
entries="$(grep -c 'OFFLOAD' /proc/net/nf_conntrack 2>/dev/null || echo 0)"
echo "flow_entries=${entries}"

# Full-cone NAT.  This firmware ships all four layers (kernel module, libnftnl,
# nftables, firewall4 — see the nft-fullcone package), so "1" here means a real,
# working feature; "0" means the module is not loaded and the page's switch
# would do nothing.  Both facts are reported separately from the switch itself
# (fw_fullcone above), because they fail independently.
if [ -d /sys/module/nft_fullcone ] || grep -q '^nft_fullcone' /proc/modules 2>/dev/null; then
	echo "fullcone=1"
else
	echo "fullcone=0"
fi

# -d: list the two module directories themselves, not their contents.  Without
# it `ls /sys/module/nf_flow_table` prints every file inside the module
# directory, `wc -l` returns a number far larger than 2, and the LuCI page —
# which only accepts 1 or 2 — reported "流表模块 未加载" on a device where both
# modules were loaded and 7 conntrack entries were already offloaded.
echo "fw4_offload_kmod=$(ls -d /sys/module/nf_flow_table /sys/module/nft_flow_offload 2>/dev/null | wc -l)"

# --- eBPF proxy (Nikki-RS / clash-rs) ----------------------------------------
#
# Read-only: this reports what the kernel and Nikki-RS are doing, and the apply
# script is what changes anything.  Three separate facts, because they fail
# independently and a single "on/off" would hide which one is missing:
#
#   ebpf_kernel   the kernel can host the eBPF datapath at all
#   ebpf_cgroup   the cgroup BPF half is compiled in (host/process matching)
#   ebpf_*        what Nikki-RS itself is configured to do
echo "ebpf_proxy=$(conf_get ebpf_proxy)"

# BPF syscall + JIT are exposed as sysctls; the TC classifier/action appear as
# modules once available.  Both sysctls are created by the core BPF options, so
# their absence is a definitive "no".
ebpf_bpf=0
if [ -e /proc/sys/net/core/bpf_jit_enable ] && [ -e /proc/sys/kernel/unprivileged_bpf_disabled ]; then
	ebpf_bpf=1
fi
ebpf_tc=0
if [ -e /sys/module/cls_bpf ] || [ -e /sys/module/act_bpf ]; then
	ebpf_tc=1
elif ls /lib/modules/"$(uname -r)"/cls_bpf.ko* >/dev/null 2>&1; then
	ebpf_tc=1
elif modprobe -n -q cls_bpf >/dev/null 2>&1; then
	ebpf_tc=1
fi
# veth is not optional: the eBPF manager builds dae0 <-> dae0peer as a link
# pair (netkit if the kernel has it, veth otherwise) before it loads any BPF
# program.  Without the module it stops with EOPNOTSUPP, so readiness has to
# include it or the page would call a datapath "ready" that cannot start.
ebpf_veth=0
if [ -e /sys/module/veth ]; then
	ebpf_veth=1
elif ls /lib/modules/"$(uname -r)"/veth.ko* >/dev/null 2>&1; then
	ebpf_veth=1
elif modprobe -n -q veth >/dev/null 2>&1; then
	ebpf_veth=1
fi
if [ "$ebpf_bpf" = 1 ] && [ "$ebpf_tc" = 1 ] && [ "$ebpf_veth" = 1 ]; then
	echo "ebpf_kernel=1"
else
	echo "ebpf_kernel=0"
fi
echo "ebpf_veth=${ebpf_veth}"

# CONFIG_CGROUP_BPF has no sysctl or module of its own.  kallsyms carries the
# static key it is built around; this script runs as root, so it is readable.
# `-m1` stops at the first match, so an enabled kernel does not pay for a full
# read of the symbol table.
if grep -qm1 'cgroup_bpf' /proc/kallsyms 2>/dev/null; then
	echo "ebpf_cgroup=1"
elif [ -r /proc/kallsyms ] && [ -s /proc/kallsyms ]; then
	echo "ebpf_cgroup=0"
else
	echo "ebpf_cgroup=unknown"
fi

if [ -f /etc/config/nikki-rs ] && [ -x /usr/bin/clash-rs ]; then
	echo "ebpf_nikki_rs=1"
else
	echo "ebpf_nikki_rs=0"
fi
echo "ebpf_enabled=$(uci -q get nikki-rs.ebpf.enabled 2>/dev/null || echo 0)"
if pidof clash-rs >/dev/null 2>&1; then
	echo "ebpf_running=1"
else
	echo "ebpf_running=0"
fi

# eBPF datapath: the manager creates the host side of the dae0/dae0peer link pair
# before it loads any program, so its existence means the datapath is up even
# when the log line below is suppressed.
if [ -e /sys/class/net/dae0 ]; then
	echo "ebpf_datapath=1"
else
	echo "ebpf_datapath=0"
fi

# Attachment: clash-rs logs the attach once the TC/cgroup programs are live, but
# that line is INFO and the Nikki-RS default is `log_level 'error'`, so it is
# usually absent on a perfectly working datapath.  This is therefore the strict
# ("log-confirmed") signal; ebpf_datapath above is the weaker one the page falls
# back to, and the two are reported separately so the page does not over-claim.
if [ -f /var/log/nikki-rs/core.log ] \
	&& grep -q 'TC/cgroup hooks successfully attached' /var/log/nikki-rs/core.log 2>/dev/null; then
	echo "ebpf_attached=1"
else
	echo "ebpf_attached=0"
fi

exit 0
