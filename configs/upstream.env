# Upstream baseline for the mainline H5000M build.
#
# WHY openwrt/openwrt main (SNAPSHOT) AND NOT 25.12
# -------------------------------------------------
# Hiveton H5000M support was added upstream by
#   6487cc9a1f  "mediatek: add support for Hiveton H5000M"   (2026-01-09)
# and that commit is only on `main`.  Verified against the published images:
#
#   releases/25.12.0 .. 25.12.5 -> profiles.json contains NO hiveton_h5000m
#   snapshots/                  -> profiles.json contains hiveton_h5000m
#
# The openwrt-25.12 *branch* head does carry the device (cherry-picked after
# the 25.12.5 tag), but no released 25.12.x image does, so SNAPSHOT `main` is
# simultaneously the newest and the only mainline upstream that ships H5000M
# firmware today.  It is also what every in-tree plugin for this board is
# verified against (luci-app-h5000m-fancontrol: "OpenWrt SNAPSHOT";
# ddimension feed: `stable/snapshot/aarch64_cortex-a53`).
#
# Set OPENWRT_REPO_BRANCH=openwrt-25.12 to build the 25.12 branch instead once
# 25.12.6 ships the device.
OPENWRT_REPO_URL=https://github.com/openwrt/openwrt.git
OPENWRT_REPO_BRANCH=main

# Reproducible baseline.  Two different facts live in this block and they are
# NOT the same fact:
#
#   * the revision the PATCH STACK is aligned to — the one
#     scripts/verify-upstream-integration.sh verifies every patch against;
#   * the last revision a FULL BUILD (image + apk repository + all three publish
#     gates) was observed to pass on.
#
# They coincided at 0f8cceb, which remains the last full-build validation.  They
# no longer do: between 0f8cceb and 99426e4 mainline bumped nftables 1.1.6 ->
# 1.1.7 and libnftnl 1.3.1 -> 1.3.2, and both fullcone userspace patches had to
# be regenerated against the new versions (see install_nftables_patches).
#
# That forces the pin forward, and the reason is not tidiness: a patch
# regenerated against nftables 1.1.7 cannot be applied to 1.1.6, because 1.1.7
# added `<*>` start-condition prefixes to the NAT keyword rules in
# src/scanner.l.  Pinning 0f8cceb would therefore make `--pinned` the one build
# mode that cannot work.  99426e4 is the revision every patch in this repository
# was then re-verified against by scripts/verify-upstream-integration.sh, using
# the exact tarballs mainline builds for that revision (PKG_HASH checked).
#
# Deliberately a fixed revision, not "whatever main's head is": main moved twice
# while this alignment work was being done, and a pin whose value tracks a moving
# target is not a pin.  `latest` is the mode that follows the branch head; this is
# the reproducible one, and it stays a valid baseline even after main bumps
# nftables again — that is the whole point of pinning it here.
#
# The patch-stack half of that is machine-verified by
# scripts/verify-upstream-integration.sh (which is also a PR gate).  The
# full-build half is re-established by the next scheduled build; when it passes,
# record that here as a separate sentence rather than letting the two facts
# blur together again.
#
# Used when OPENWRT_TRACK=pinned, and recorded as the fallback baseline in
# BUILD-INFO.txt when tracking `latest`.
#
# The kernel ABI moves between snapshots that both call themselves 6.18.44
# (3a22303 -> 8ae0a62b, 0f8cceb -> f3b7e5e1), which is why the kmods and the
# pinned sing-box ship inside the image and in this project's own repository
# rather than being fetched from the official snapshot.
OPENWRT_PINNED_REVISION=99426e4f7d5d712f4cb488dddf30a0af32e6d407
OPENWRT_PINNED_SNAPSHOT=r0-99426e4

# `latest` (default) follows the branch head on every build — that is the point
# of a scheduled auto-build.  `pinned` builds OPENWRT_PINNED_REVISION so a build
# can be reproduced exactly; scripts/local-build.sh --pinned selects it.
OPENWRT_TRACK=latest

# Target triple, as published by OpenWrt.
OPENWRT_TARGET=mediatek
OPENWRT_SUBTARGET=filogic
OPENWRT_PROFILE=hiveton_h5000m
OPENWRT_ARCH=aarch64_cortex-a53
OPENWRT_IMAGE_PREFIX=openwrt-mediatek-filogic-hiveton_h5000m

# Optional fallback modem stack.  luci-app-mt5700m (the FAN789 panel for the
# built-in MT5700M) hard-depends on `ubus-at-daemon` and `sms-tool_q`, and both
# are packaged only by the QModem feed.  write_feeds_conf() therefore appends
# this feed *only* when ENABLE_MT5700M=true; a wwand build never sees it, since
# the two stacks are mutually exclusive and QModem brings its own drivers.
QMODEM_REPO_URL=https://github.com/FUjr/QModem.git
QMODEM_REPO_BRANCH=main
