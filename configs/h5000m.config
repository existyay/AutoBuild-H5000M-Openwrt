#
# configs/h5000m.config — always-on base configuration for the Hiveton H5000M.
#
# Copied to .config before `make defconfig`.  Feature blocks driven by the
# ENABLE_* switches are appended by scripts/local-build.sh afterwards, so this
# file holds only the target selection and the things this board needs in order
# to be a router at all.
#
# Target: MediaTek MT7987A (Filogic 860) + MT7992 Wi-Fi 7, 2x 2.5GbE.
# Device support comes from OpenWrt itself — target/linux/mediatek/image/
# filogic.mk :: Device/hiveton_h5000m.  We do not maintain a DTS, a port layout
# or a kernel patch for this board; the only tree patch is the fan policy one
# in ../patches/.
#

# --------------------------------------------------------------- target ------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_hiveton_h5000m=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TARGET_IMAGES_GZIP=y

# Do not build every package on the planet — image size and build time.
CONFIG_ALL=n
CONFIG_ALL_KMODS=n
CONFIG_ALL_NONSHARED=n

# ------------------------------------------------------------ build host -----
# Verbose-ish output in CI logs without drowning them.
CONFIG_BUILD_LOG=y

# ------------------------------------------------------------------ LuCI -----
# The board ships as an HTTPS admin UI in Simplified Chinese.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y

# Simplified Chinese is selected through LuCI's language gate, not by naming
# the translation packages.  The kconfig symbol is LUCI_LANG_zh_Hans (it follows
# the po/ directory name) while the packages are luci-i18n-<app>-zh-cn, and each
# of those defaults to `LUCI_LANG_zh_Hans` and depends on its own app.  Setting
# the language here therefore turns on zh-cn for every installed LuCI app,
# including luci-app-h5000m-fancontrol and luci-app-h5000m-netmode — listing the
# translation packages individually does not work, because their symbol defaults
# to "not set" and defconfig drops them.
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_zh_Hant=n
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# ------------------------------------------------------------ base system ----
CONFIG_PACKAGE_jshn=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

# --------------------------------------------------------------- storage -----
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# ------------------------------------------------------------ diagnostics ----
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
# ttyd alone installs only the daemon: without its LuCI app there is no page to
# reach the web terminal from, so the daemon is present but unusable.  Both
# FAN789's builder and the vendor defconfig ship the pair.
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# --------------------------------------------------------------- IPv6 -------
# The stock mt7987_mt7992 profile turns IPV6 on but leaves most of the IPv6
# netfilter chain off.  A 5G CPE with a delegated /64 needs the full stack.
CONFIG_PACKAGE_kmod-nf-ipt6=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-ip6tables-extra=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_kmod-nf-nat6=y
CONFIG_PACKAGE_kmod-ip6-tunnel=y
CONFIG_PACKAGE_libip6tc=y
CONFIG_PACKAGE_ip6tables-mod-nat=y
CONFIG_PACKAGE_ip6tables-extra=y
CONFIG_PACKAGE_ip6tables-nft=y

# ------------------------------------------------------------ feeds ---------
# wwand is a third-party feed (ddimension/openwrt-repo).  Without this, OpenWrt
# advertises it in the image's /etc/apk/repositories.d/distfeeds.list at
#
#   https://downloads.openwrt.org/snapshots/packages/aarch64_cortex-a53/wwand/packages.adb
#
# which does not exist there, so every `apk update` on the device ends with
# "wget: exited with error 8" and "unexpected end of file".  feeds.mk emits that
# line for any feed whose CONFIG_FEED_<name> is set, and prefixes it with '#' only
# when the value is exactly `m` (include/feeds.mk:60).  CONFIG_FEED_* is used
# nowhere else in the build system — it does not select or install anything — so
# `m` here only suppresses the bogus URL.  The wwand packages themselves reach
# the device through this project's own repository instead.
CONFIG_FEED_wwand=m
